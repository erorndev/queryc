    {
      "name": "DataErrReader",
      "summary": "DataErrReader changes the way errors are handled by a Reader. Normally, a Reader returns an error (typically EOF) from the first Read call after the last piece of data is read. DataErrReader wraps a Reader and changes its behavior so the final error is returned along with the final data, instead of in the first call after the final data.",
      "signature": "func DataErrReader(r io.Reader) io.Reader { return &dataErrReader{r, nil, make([]byte, 1024)} }",
      "params": [
        {
          "name": "r",
          "type": "io.Reader"
        }
      ],
      "returns": {
        "type": "io.Reader { return &dataErrReader{r, nil, make([]byte, 1024)} }"
      },
      "versions": [
