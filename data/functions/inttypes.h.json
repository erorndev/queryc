      "name": "strtoimax",
      "summary": "Converts the initial portion of the string pointed to by nptr to intmax_t representation according to base.",
      "signature": "intmax_t strtoimax(const char * restrict nptr, char ** restrict endptr, int base);",
      "params": [
        {
          "name": "nptr",
          "type": "const char * restrict",
          "description": "Null-terminated string to convert."
        },
        {
          "name": "endptr",
          "type": "char ** restrict",
          "description": "Optional pointer to store the address of the first unconverted character."
        },
        {
          "name": "base",
          "type": "int",
          "description": "Number base (0, or 2 through 36)."
        }
      ],
      "returns": {
        "type": "intmax_t",
        "description": "The converted value, zero if no conversion could be performed, or INTMAX_MAX or INTMAX_MIN (with ERANGE stored in errno) on overflow."
