      "example": "#include <inttypes.h>\n#include <stdio.h>\n\nint main(void) {\n    char *end = NULL;\n    intmax_t v = strtoimax(\"12345\", &end, 10);\n    printf(\"%\" PRIdMAX \"\\n\", v);\n    return 0;\n}",
