      "name": "raise",
      "summary": "Sends the signal sig to the executing program. If a signal handler is invoked, raise does not return until the handler returns.",
      "signature": "int raise(int sig);",
      "params": [
        {
          "name": "sig",
          "type": "int",
          "description": "Signal number to send."
        }
      ],
      "returns": {
        "type": "int",
        "description": "Zero if successful, nonzero if unsuccessful."
      },
      "example": "#include <signal.h>\n#include <stdio.h>\n\nstatic void handler(int sig) {\n    (void)sig;\n}\n\nint main(void) {\n    signal(SIGTERM, handler);\n    if (raise(SIGTERM) != 0) {\n        puts(\"raise failed\");\n    }\n    return 0;\n}",
