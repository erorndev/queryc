    {
      "name": "signal",
      "summary": "Sets how the signal sig is handled: SIG_DFL for default handling, SIG_IGN to ignore the signal, or a pointer to a handler function to call when the signal occurs.",
      "signature": "void (*signal(int sig, void (*func)(int)))(int);",
      "params": [
        {
          "name": "sig",
          "type": "int",
          "description": "Signal number to configure."
        },
        {
          "name": "func",
          "type": "void (*)(int)",
          "description": "Handler function pointer, SIG_DFL, or SIG_IGN."
        }
      ],
      "returns": {
        "type": "void (*",
        "description": "The previous value of func for the specified signal if successful, or SIG_ERR (with errno set to a positive value) if the request cannot be honored."
      },
      "example": "#include <signal.h>\n#include <stdio.h>\n\nstatic volatile sig_atomic_t flagged = 0;\n\nstatic void on_term(int sig) {\n    (void)sig;\n    flagged = 1;\n}\n\nint main(void) {\n    if (signal(SIGTERM, on_term) == SIG_ERR) {\n        puts(\"signal failed\");\n        return 1;\n    }\n    raise(SIGTERM);\n    printf(\"flagged=%d\\n\", (int)flagged);\n    return 0;\n}",
