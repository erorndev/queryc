      "name": "setlocale",
      "summary": "Selects or queries the program's current locale for the specified category.",
      "signature": "char *setlocale(int category, const char *locale);",
      "params": [
        {
          "name": "category",
          "type": "int",
          "description": "Locale category (such as LC_ALL, LC_CTYPE, or LC_NUMERIC)."
        },
        {
          "name": "locale",
          "type": "const char *",
          "description": "Locale name string, \"C\", \"\", or NULL to query."
        }
      ],
      "returns": {
        "type": "char *",
        "description": "Pointer to the string associated with the specified category for the new (or current) locale, or a null pointer if the selection cannot be honored."
