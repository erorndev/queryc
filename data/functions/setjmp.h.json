  "header": "setjmp.h",
  "functions": [
    {
      "name": "longjmp",
      "summary": "Restores the environment saved by the most recent invocation of setjmp with the corresponding env, transferring control back to that point.",
      "signature": "[[noreturn]] void longjmp(jmp_buf env, int val);",
      "params": [
        {
          "name": "env",
          "type": "jmp_buf",
          "description": "Saved jmp_buf environment."
        },
        {
          "name": "val",
          "type": "int",
          "description": "Value for setjmp to return (1 if val is 0)."
        }
      ],
      "returns": {
        "type": "void",
        "description": "Does not return; causes the corresponding setjmp invocation to return val (or 1 if val is 0)."
      },
      "example": "#include <setjmp.h>\n#include <stdio.h>\n\nstatic jmp_buf env;\n\nstatic void fail(void) {\n    longjmp(env, 1);\n}\n\nint main(void) {\n    if (setjmp(env) == 0) {\n        fail();\n    } else {\n        puts(\"recovered\");\n    }\n    return 0;\n}",
